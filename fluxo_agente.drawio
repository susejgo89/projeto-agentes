        <!-- 4. Validação -->
        <mxCell id="n4" value="4. Validação:&#xa;Horário identificado e livre?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="405" y="340" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- Ramo NÃO: Controle de tentativas -->
