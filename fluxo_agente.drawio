<mxfile host="app.diagrams.net" agent="Antigravity" version="24.7.17">
  <diagram id="fluxo-auto-facil" name="Fluxo do Agente">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 1. Mensagem do cliente -->
        <mxCell id="n1" value="1. Mensagem do Cliente&#xa;(Entrada no terminal - Tentativa 1 a 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="30" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- 2. LLM -->
        <mxCell id="n2" value="2. LLM (Ollama qwen2.5:3b)&#xa;Interpreta o pedido e extrai o horário (ex.: 14h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="280" height="65" as="geometry" />
        </mxCell>

        <!-- 3. Ferramenta simulada -->
        <mxCell id="n3" value="3. Ferramenta Simulada&#xa;ver_horarios_livres() -&gt; [08h, 10h, 14h, 16h]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="235" width="280" height="65" as="geometry" />
